+    def serialize(self, id: Optional[Union[int, list[int], np.ndarray]] = None) -> list[Any]:
+        self._assert_is_not_closed()
+        id = self._wrap_id(id)
+        values = []
+        for i in id:
+            self.workers[i].parent_remote.send(["serialize", {}])
+            values.append(self.workers[i].parent_remote.recv())
+        return values
+
+    def restore_from_storage(self, data: list[Any], id: Optional[Union[int, list[int], np.ndarray]] = None) -> list[Any]:
+        self._assert_is_not_closed()
+        id = self._wrap_id(id)
+        for index, i in enumerate(id):
+            self.workers[i].parent_remote.send(["restore_from_storage", data[index]])
+        return [self.workers[i].parent_remote.recv() for i in id]
