+from dataclasses import dataclass
+
+import torch
+
+
+@dataclass(frozen=True)
+class ValidActionContract:
+    """Physical action domain shared by endpoint and path supervision."""
+
+    chunk_length: int
+    action_dims: int
+
+    def __post_init__(self) -> None:
+        if self.chunk_length <= 0 or self.action_dims <= 0:
+            raise ValueError("Action contract dimensions must be positive.")
+
+    def crop(self, tensor: torch.Tensor) -> torch.Tensor:
+        """Return only executable chunk positions and physical action dimensions."""
+        if tensor.ndim < 2:
+            raise ValueError(f"Expected action tensor rank >= 2, got {tensor.ndim}.")
+        if tensor.shape[-2] < self.chunk_length:
+            raise ValueError(
+                f"Action horizon {tensor.shape[-2]} is shorter than valid chunk "
+                f"length {self.chunk_length}."
+            )
+        if tensor.shape[-1] < self.action_dims:
+            raise ValueError(
+                f"Action width {tensor.shape[-1]} is shorter than physical width "
+                f"{self.action_dims}."
+            )
+        return tensor[..., : self.chunk_length, : self.action_dims]
+
+    def mask_like(self, tensor: torch.Tensor) -> torch.Tensor:
+        """Build a boolean mask over the full model action tensor."""
+        self.crop(tensor)
+        mask = torch.zeros_like(tensor, dtype=torch.bool)
+        mask[..., : self.chunk_length, : self.action_dims] = True
+        return mask
+
+    def valid_count(self, tensor: torch.Tensor) -> int:
+        """Return the number of scalar physical-action entries."""
+        return int(self.mask_like(tensor).sum().item())
