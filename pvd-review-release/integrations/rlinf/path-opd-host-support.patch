+    def capture_checkpoint_state(self):
+        """Capture exact continuation state at a post-update safe boundary."""
+        return {
+            "subprocess_environment": self.env.serialize(),
+            "generator_state": copy.deepcopy(self._generator.bit_generator.state),
+            "ordered_generator_state": copy.deepcopy(
+                self._generator_ordered.bit_generator.state
+            ),
+            "is_start": self._is_start,
+            "start_idx": self.start_idx,
+            "reset_state_ids_all": self.reset_state_ids_all.copy(),
+            "reset_state_ids": self.reset_state_ids.copy(),
+            "last_reset_state_ids": self.last_reset_state_ids.copy(),
+            "task_ids": self.task_ids.copy(),
+            "trial_ids": self.trial_ids.copy(),
+            "task_sequence": copy.deepcopy(self.task_sequence),
+            "current_task": copy.deepcopy(self.current_task),
+            "current_task_idx": copy.deepcopy(self.current_task_idx),
+            "previous_info": copy.deepcopy(self.previous_info),
+            "task_descriptions": copy.deepcopy(self.task_descriptions),
+            "prev_step_reward": self.prev_step_reward.copy(),
+            "success_once": self.success_once.copy(),
+            "fail_once": self.fail_once.copy(),
+            "returns": self.returns.copy(),
+            "elapsed_steps": self._elapsed_steps.copy(),
+        }
+
+    def restore_checkpoint_state(self, state):
+        """Restore exact continuation state without selecting a new task/reset."""
+        self.restore_checkpoint_metadata(state)
+        restored = self.env.restore_from_storage(state["subprocess_environment"])
+        raw_obs = [item["state_obs"] for item in restored]
+        return self._wrap_obs(raw_obs)
+
+    def restore_checkpoint_metadata(self, state):
+        """Restore sampler, task cursor, and accounting without touching physics."""
+        self._generator.bit_generator.state = copy.deepcopy(state["generator_state"])
+        self._generator_ordered.bit_generator.state = copy.deepcopy(
+            state["ordered_generator_state"]
+        )
+        self._is_start = state["is_start"]
+        self.start_idx = state["start_idx"]
+        for name in (
+            "reset_state_ids_all",
+            "reset_state_ids",
+            "last_reset_state_ids",
+            "task_ids",
+            "trial_ids",
+            "prev_step_reward",
+            "success_once",
+            "fail_once",
+            "returns",
+        ):
+            setattr(self, name, state[name].copy())
+        self._elapsed_steps = state["elapsed_steps"].copy()
+        for name in (
+            "task_sequence",
+            "current_task",
+            "current_task_idx",
+            "previous_info",
+            "task_descriptions",
+        ):
+            setattr(self, name, copy.deepcopy(state[name]))
+
+    def replay_checkpoint_state(self, state, action_history):
+        """Reconstruct portable physics state from the last reset and actions."""
+        obs, _ = self.reset(reset_state_ids=state["last_reset_state_ids"])
+        for actions in action_history:
+            chunk_obs, _, _, _, _ = self.chunk_step(actions)
+            obs = chunk_obs[-1]
+        self.restore_checkpoint_metadata(state)
+        obs["task_descriptions"] = copy.deepcopy(self.task_descriptions)
+        return obs
+
     def step(self, actions=None, auto_reset=True):
